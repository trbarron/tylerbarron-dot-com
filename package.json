{
  "name": "tb-website",
  "version": "5.62.2",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build --mode=production",
    "build:arc": "npm run build && npm run build:arc:assets && npm run build:arc:server && npm run build:arc:deps",
    "build:arc:assets": "mkdir -p public && cp -r build/client/* public/",
    "build:arc:server": "mkdir -p server && NODE_ENV=production npx esbuild server.ts --platform=node --target=node24 --format=esm --bundle --minify --tree-shaking=true --outfile=server/index.mjs '--external:@aws-sdk/*' --external:aws-sdk '--external:@react-router/*' --external:react --external:react-dom '--external:./build/*' && rm -rf server/build/server && mkdir -p server/build/server && cp -r build/server/* server/build/server/",
    "build:arc:deps": "node scripts/install-lambda-deps.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "analyze:deps": "cd server && npx npm-check -u",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:baseline": "playwright test --update-snapshots",
    "test:visual:update": "playwright test --update-snapshots",
    "test:deploy": "echo '\n🧪 Simulating Lambda Deployment\n' && npm run build:arc:server && npm run build:arc:deps && echo '\n📊 Size Analysis:' && echo 'Lambda Handler: '$(du -sh server/index.mjs 2>/dev/null | awk '{print $1}' || echo 'Not built') && echo 'SSR Build: '$(du -sh server/build 2>/dev/null | awk '{print $1}' || echo 'Not built') && echo 'Dependencies: '$(du -sh server/node_modules 2>/dev/null | awk '{print $1}' || echo 'Not installed') && echo 'TOTAL: '$(du -sh server 2>/dev/null | awk '{print $1}' || echo 'Not built') && echo '\n✅ Images in Lambda: '$(find server -name '*.jpg' -o -name '*.png' -o -name '*.gif' 2>/dev/null | grep -v node_modules | wc -l | tr -d ' ')' (should be 0)' && echo '✅ Ready to deploy!\n'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "react-router dev",
    "dev:arc": "npm run build:arc && arc sandbox -e testing",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "check:og": "node scripts/check-og-images.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:lambda-deps": "node scripts/check-lambda-deps.mjs",
    "prepare": "husky",
    "typecheck": "tsc",
    "pr-screenshots": "node scripts/pr-screenshots.mjs",
    "camel:queue": "node --env-file-if-exists=.env scripts/camel-queue.mjs"
  },
  "dependencies": {
    "@ballatech/react-router7-preset-aws": "^1.0.1",
    "@google/model-viewer": "^4.4.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "d3-geo": "^3.1.2",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "topojson-client": "^3.1.0",
    "yet-another-react-lightbox": "^3.33.0"
  },
  "devDependencies": {
    "@architect/architect": "^12.0.1",
    "@aws-sdk/client-sns": "^3.1162.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gltf-transform/cli": "^4.5.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^7.18.5",
    "@react-router/node": "^7.18.5",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/aws-lambda": "^8.10.164",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-img-size": "^1.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.6",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "stockfish": "18.0.7",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "release": {
    "branches": [
      "master"
    ],
    "tagFormat": "${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": true,
    "printWidth": 120
  }
}
